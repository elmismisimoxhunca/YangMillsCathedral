\title{
Self-duality in four-dimensional Riemannian geometry
}

\author{
By M. F. Atiyah,† F.R.S., N. J. Hitchin † \\ and I. M. Singer ‡ \\ † Mathematical Institute, University of Oxford, 24-29 St Giles', Oxford, U.K. \\ ‡ Department of Mathematics, University of California, Berkeley, California 94720, U.S.A.
