\hline $S U ( n )$ & $4 n k - n ^ { 2 } + 1$ & \\
\hline $\operatorname { Spin } ( n )$ & $4 ( n - 2 ) k - \frac { 1 } { 2 } n ( n - 1 )$ & ( $n \geqslant 7$ ) \\
\hline $\operatorname { Sp } ( n )$ & $4 ( n + 1 ) k - n ( 2 n + 1 )$ & \\
\hline $G _ { 2 }$ & $16 k - 14$ & \\
\hline $F _ { 4 }$ & $36 k - 52$ & \\
\hline $E _ { 6 }$ & $48 k - 78$ & \\
\hline $E _ { 7 }$ & $72 k - 133$ & \\
